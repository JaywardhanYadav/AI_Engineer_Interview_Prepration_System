# Required: Your OpenAI API key
OPENAI_API_KEY=sk-...

# Models
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Docker Weaviate settings
WEAVIATE_HOST=127.0.0.1
WEAVIATE_HTTP_PORT=8085
WEAVIATE_GRPC_PORT=50052
WEAVIATE_COLLECTION=InterviewKnowledge

# Efficient Reranker settings (FlashRank cross-encoder)
# Options: ms-marco-TinyBERT-L-2-v2 (ultra-fast ~5ms), ms-marco-MiniLM-L-12-v2 (balanced)
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Hybrid Search & Reranking tuning
HYBRID_ALPHA=0.5             # 0.0 = BM25 pure keyword, 1.0 = pure vector dense, 0.5 = balanced hybrid
RETRIEVAL_CANDIDATES=20      # Chunks retrieved from Weaviate before reranking
TOP_K=6                      # Final top chunks kept after FlashRank cross-encoder

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
